# ─── Server Configuration ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Runtime (pooler)
DATABASE_URL="postgresql://postgres:password@localhost:5432/focura_test"
# Direct (for migrations / introspection)
DIRECT_URL="postgresql://postgres:password@localhost:5432/focura_test"

# ─── Database Pool ────────────────────────────────────────────────────────────
DB_MAX_CONNECTIONS=100
INSTANCE_COUNT=1
PRIMARY_POOL_RATIO=0.3
REPLICA_POOL_RATIO=0.7
QUERY_TIMEOUT_MS=30000

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ─── Upstash Redis (serverless) ──────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── JWT / Auth ──────────────────────────────────────────────────────────────
# Generate RSA keys: node scripts/generate-keys.js
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
# Production (base64 encoded, use instead of file paths):
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

ACCESS_TOKEN_SECRET=
# Shared secret for /api/v1/internal (backend-to-backend) tooling: the Next.js
# server authenticates via a short-lived HMAC proof signed with NEXTAUTH_SECRET.
NEXTAUTH_SECRET=
# Number of trusted reverse-proxy hops for req.ip (Railway: 1).
TRUST_PROXY_HOPS=1
JWT_EXPIRES_IN=7d

# ─── Admin User IDs ──────────────────────────────────────────────────────────
# Comma-separated Prisma User IDs that get full admin access
FOCURA_ADMIN_IDS=

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="Focura <noreply@example.com>"

# ─── Cloudinary (image uploads) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Payment Provider ────────────────────────────────────────────────────────
# Set to 'lemonsqueezy', 'paddle', or 'stripe'. No code changes needed.
PAYMENT_PROVIDER=lemonsqueezy

# Frontend base URL used to build checkout success/cancel URLs and the customer
# portal return URL. Resolved as CLIENT_URL (above) -> APP_URL -> NEXT_PUBLIC_APP_URL.
# In production this must point at the deployed frontend (e.g. https://focura-client.vercel.app)
# or customers get redirected to localhost after paying.
APP_URL=http://localhost:3000

# ── Stripe Billing ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# ── Paddle Billing (only needed if PAYMENT_PROVIDER=paddle) ──────────────────
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_PRICE_PRO_MONTHLY=
# PADDLE_PRICE_PRO_YEARLY=

# ── Lemon Squeezy Billing (only needed if PAYMENT_PROVIDER=lemonsqueezy) ─────
# API Key from Settings > API in your Lemon Squeezy dashboard
LEMONSQUEEZY_API_KEY=
# Store ID from Settings > Stores in your Lemon Squeezy dashboard
LEMONSQUEEZY_STORE_ID=
# Webhook Secret from Settings > Webhooks in your Lemon Squeezy dashboard
LEMONSQUEEZY_WEBHOOK_SECRET=
# Variant IDs for each plan and billing cycle (create products first)
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_BUSINESS_MONTHLY=
LEMONSQUEEZY_VARIANT_BUSINESS_YEARLY=
# PADDLE_PRICE_BUSINESS_MONTHLY=
# PADDLE_PRICE_BUSINESS_YEARLY=

# ─── Cache TTLs (seconds) ───────────────────────────────────────────────────
CACHE_TTL_WORKSPACE_METADATA=3600    # Workspace by ID/slug (default: 1 hour)
CACHE_TTL_LABEL_LIST=1800            # Label lists (default: 30 minutes)
CACHE_TTL_ANALYTICS=3600             # Analytics data (default: 1 hour)
CACHE_TTL_WORKSPACE_OVERVIEW=3600    # Workspace overview (default: 1 hour)
CACHE_TTL_WORKSPACE_STATS=1800

# ─── Sentry (error tracking) ────────────────────────────────────────────────
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=focura-backend@1.0.0

# ─── Ngrok (dev tunneling for webhooks) ─────────────────────────────────────
NGROK_AUTH_TOKEN=

# ─── Integration OAuth Apps ─────────────────────────────────────────────────
# Register at:
#   GitHub:  https://github.com/settings/developers
#   Slack:   https://api.slack.com/apps
#   Google:  https://console.cloud.google.com/apis/credentials
#   Trello:  https://trello.com/power-ups/admin

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

TRELLO_CLIENT_ID=
TRELLO_CLIENT_SECRET=

# ── AI (Google Gemini) — server-side only, never expose to the client ──
# Required for AI features (tasks.autocomplete, goals.breakdown, comments.assist)
GEMINI_API_KEY=
# Optional overrides
GEMINI_MODEL_LITE=gemini-2.5-flash-lite
GEMINI_MODEL_STD=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_REQUEST_TIMEOUT_MS=15000
