{
  "name": "focura-backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:create": "prisma migrate dev --create-only",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate",
    "deploy": "npm run build && prisma migrate deploy && npm start",
    "test": "vitest run",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run src/tests/unit",
    "test:integration": "vitest run src/tests/integrations",
    "test:verbose": "vitest run --reporter=verbose",
    "test:ui": "vitest --ui",
    "test:file": "vitest run",
    "db:setup": "prisma generate && prisma db push --force-reset",
    "db:seed": "tsx prisma/seed.ts",
    "test:performance": "tsx performance/run-tests.ts",
    "test:performance:api": "tsx performance/api-tests.ts",
    "test:performance:simple": "tsx performance/simple-api-tests.ts",
    "test:performance:database": "tsx performance/database-tests.ts",
    "test:performance:service": "tsx performance/service-tests.ts",
    "test:performance:load": "tsx performance/load-tests.ts",
    "test:performance:check": "tsx performance/check-server.ts"
  },
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "@paddle/paddle-node-sdk": "^3.8.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.62.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.2",
    "argon2": "^0.44.0",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "escape-html": "^1.0.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "isomorphic-dompurify": "^3.12.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.11",
    "slugify": "^1.6.6",
    "stripe": "^20.4.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^9.9.0",
    "@types/autocannon": "^7.12.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/escape-html": "^1.0.4",
    "@types/express": "^5.0.5",
    "@types/express-validator": "^2.20.33",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.1.0",
    "@types/nodemailer": "^7.0.4",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autocannon": "^8.0.0",
    "dotenv-cli": "^7.4.4",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "msw": "^2.13.3",
    "nodemon": "^3.1.11",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-node": "^11.0.0-beta.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.4"
  }
}
